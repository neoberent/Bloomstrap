<!--
    Bloomstrap control refinements. Colours come from Palette.axaml.
    Motion: hover 120 ms, state 180 ms, CubicEaseOut. Nothing bounces, scales or glows.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives"
        xmlns:controls="using:Froststrap.UI.Elements.Controls">

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource BloomFont}" />
        <Setter Property="FontSize" Value="{DynamicResource BloomTextBody}" />
        <Setter Property="Foreground" Value="{DynamicResource BloomTextBrush}" />
    </Style>

    <!--
        Hover = a 1px outline that fades in (120 ms). Backgrounds switch instantly: fading a fill
        from "transparent" (#00FFFFFF in Fluent/Avalonia) blends through white and blinks.
    -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton /template/ ContentPresenter#PART_ContentPresenter,
                     RepeatButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Pressed feedback: a brief dip in opacity, nothing that moves or scales -->
    <Style Selector="Button, ToggleButton, RepeatButton">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pressed, ToggleButton:pressed, RepeatButton:pressed">
        <Setter Property="Opacity" Value="0.86" />
    </Style>

    <!-- Sidebar: the selection pip is a little petal; it fades, hover fills switch instantly -->
    <Style Selector="uip|FANavigationViewItemPresenter /template/ Border#SelectionIndicator">
        <Setter Property="Background" Value="{DynamicResource BloomPetalVerticalBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Lists: the row outline fades between rest, hover and selected -->
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem Border#ItemBorder">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Popups ease in rather than appearing at full strength -->
    <Style Selector="MenuFlyoutPresenter, FlyoutPresenter, ToolTip">
        <Style.Animations>
            <Animation Duration="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>


    <!-- ───── Buttons ───── -->

    <!-- Quiet secondary action: text only until hovered (Skip, Restart, Save, Close) -->
    <Style Selector="Button.quiet">
        <Setter Property="Background" Value="{DynamicResource BloomClearBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BloomLineClearBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BloomSubtextBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource BloomRadiusControl}" />
        <Setter Property="FontSize" Value="{DynamicResource BloomTextBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BloomClearBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BloomLineHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BloomTextBrush}" />
    </Style>
    <Style Selector="Button.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BloomSurfaceSolidBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BloomLineHoverBrush}" />
    </Style>

    <!-- Regular buttons: same outline signal on hover -->
    <Style Selector="Button:not(.quiet):pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BloomLineHoverBrush}" />
    </Style>

    <!-- Primary split button: one mauve pill, a hairline divider, each half lights on its own -->
    <Style Selector="controls|IconButton.DropDownButton.Primary">
        <Setter Property="FontSize" Value="{DynamicResource BloomTextBody}" />
    </Style>
    <Style Selector="controls|IconButton.DropDownButton.Primary /template/ Button#PART_PrimaryButton">
        <Setter Property="Background" Value="{DynamicResource BloomPetalLeftBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8,0,0,8" />
    </Style>
    <Style Selector="controls|IconButton.DropDownButton.Primary /template/ Button#PART_SecondaryButton">
        <Setter Property="Background" Value="{DynamicResource BloomPetalRightBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource BloomOnAccentDividerBrush}" />
        <Setter Property="CornerRadius" Value="0,8,8,0" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="controls|IconButton.DropDownButton.Primary:not(:disabled):pointerover /template/ Button#PART_PrimaryButton">
        <Setter Property="Background" Value="{DynamicResource BloomPetalLeftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BloomOnAccentDividerBrush}" />
    </Style>
    <Style Selector="controls|IconButton.DropDownButton.Primary:not(:disabled):pointerover /template/ Button#PART_SecondaryButton">
        <Setter Property="Background" Value="{DynamicResource BloomPetalRightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BloomOnAccentDividerBrush}" />
    </Style>
    <Style Selector="controls|IconButton.DropDownButton.Primary:not(:disabled) /template/ Button#PART_PrimaryButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource BloomPetalLeftHoverBrush}" />
    </Style>
    <Style Selector="controls|IconButton.DropDownButton.Primary:not(:disabled) /template/ Button#PART_SecondaryButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource BloomPetalRightHoverBrush}" />
    </Style>
    <!-- Button's own template paints its ContentPresenter; keep the petal there too -->
    <Style Selector="controls|IconButton.DropDownButton.Primary:not(:disabled) /template/ Button#PART_PrimaryButton /template/ ContentPresenter#PART_ContentPresenter,
                     controls|IconButton.DropDownButton.Primary:not(:disabled) /template/ Button#PART_SecondaryButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <!-- ───── Cards: #313244, 1px #45475a, radius 10, 16/12 padding everywhere ───── -->
    <Style Selector="controls|Card">
        <Setter Property="CornerRadius" Value="{DynamicResource BloomRadiusCard}" />
    </Style>
    <Style Selector="controls|OptionControl, controls|CardExpander, controls|CardAction">
        <Setter Property="Background" Value="{DynamicResource BloomCardGlassBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BloomGlassEdgeBrush}" />
    </Style>
    <Style Selector="controls|CardAction">
        <Setter Property="CornerRadius" Value="{DynamicResource BloomRadiusCard}" />
    </Style>
    <!-- Cards: the outline brightens under the pointer; cards that do something also lift
         to the hover surface (instantly, no fade) -->
    <Style Selector="controls|Card:pointerover">
        <Setter Property="Background" Value="{DynamicResource BloomCardGlassBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BloomLineHoverBrush}" />
    </Style>
    <Style Selector="controls|CardAction:pointerover /template/ controls|Card">
        <Setter Property="Background" Value="{DynamicResource BloomCardGlassHoverBrush}" />
    </Style>

    <!-- ───── Toggles: on = mauve, off = clearly quieter ───── -->
    <Style Selector="ToggleSwitch:unchecked">
        <Setter Property="Foreground" Value="{DynamicResource BloomHintBrush}" />
    </Style>

    <!-- ───── Sidebar wordmark ───── -->
    <Style Selector="TextBlock.wordmark">
        <Setter Property="FontSize" Value="{DynamicResource BloomTextBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BloomPetalBrush}" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Mono for anything that is data: flag names, values, paths, logs -->
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{DynamicResource BloomMonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource BloomMonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Section label, hint and status chips -->
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{DynamicResource BloomHintBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource BloomTextCaption}" />
    </Style>

    <Style Selector="Border.chip">
        <Setter Property="CornerRadius" Value="{DynamicResource BloomRadiusPill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource BloomSurfaceBrush}" />
    </Style>
    <Style Selector="Border.chip > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource BloomSubtextBrush}" />
    </Style>
    <Style Selector="Border.chip.ok > TextBlock"><Setter Property="Foreground" Value="{DynamicResource BloomSuccessBrush}" /></Style>
    <Style Selector="Border.chip.warn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource BloomWarningBrush}" /></Style>
    <Style Selector="Border.chip.danger > TextBlock"><Setter Property="Foreground" Value="{DynamicResource BloomDangerBrush}" /></Style>

    <!-- Progress: one thin mauve line -->
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource BloomPetalBrush}" />
        <Setter Property="Background" Value="{DynamicResource BloomSurfaceBrush}" />
        <Setter Property="MinHeight" Value="3" />
        <Setter Property="CornerRadius" Value="{DynamicResource BloomRadiusPill}" />
    </Style>

    <!-- Sidebar items: capsule shape, calm hover -->
    <Style Selector="ui|FANavigationViewItem">
        <Setter Property="CornerRadius" Value="{DynamicResource BloomRadiusControl}" />
        <Setter Property="FontSize" Value="{DynamicResource BloomTextBody}" />
    </Style>

    <!-- Tooltips and flyouts: mantle surface, 1px line, no Fluent acrylic -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BloomPopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BloomLineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BloomTextBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource BloomRadiusControl}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource BloomPopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BloomLineBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource BloomRadiusCard}" />
    </Style>
</Styles>
